# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/totp_auth?schema=public"

# --- SECRETS (never commit real values) ---
# AES-256 requires a 32-byte key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# JWT signing secrets (long random strings). Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Token lifetimes
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Throttling for /verify and /verify/backup (attempts per minute)
VERIFY_RATE_LIMIT_TTL_SECONDS=60
VERIFY_RATE_LIMIT_MAX_ATTEMPTS=5

# OTP window tolerance (time steps before/after current, default 1)
TOTP_WINDOW=1

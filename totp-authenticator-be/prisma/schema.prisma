generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  passwordHash      String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  refreshTokenHash  String?
  accounts          TotpAccount[]
  verificationLogs  VerificationLog[]
}

model TotpAccount {
  id                  String           @id @default(uuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer              String
  label               String
  encryptedSecret     String           @map("encrypted_secret")
  lastAcceptedStep    BigInt           @default(0) @map("last_accepted_step")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  verificationLogs    VerificationLog[]
  backupCodes         BackupCode[]

  @@index([userId])
  @@unique([userId, id])
  @@map("totp_accounts")
}

model BackupCode {
  id                String      @id @default(uuid())
  accountId         String
  account           TotpAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  codeHash          String      @map("code_hash")
  usedAt            DateTime?
  createdAt         DateTime    @default(now())

  @@index([accountId])
  @@map("backup_codes")
}

model VerificationLog {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId     String?
  account       TotpAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
success       Boolean
  step          BigInt?
  kind          String        @default("totp")
  createdAt     DateTime      @default(now())

  @@index([accountId, createdAt])
  @@map("verification_logs")
}
